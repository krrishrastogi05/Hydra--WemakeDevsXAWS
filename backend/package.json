{
  "name": "hydra-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "HYDRA API: officer briefs (Amazon Bedrock), saved plans (DynamoDB) and new areas (Lambda + S3)",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-lambda": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "start": "tsx src/local.ts",
